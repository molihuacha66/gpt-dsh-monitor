{
  "name": "@local/dsh-codex-bridge",
  "version": "0.7.0-beta.1",
  "private": true,
  "type": "module",
  "description": "DSH 与 OpenAI Codex 的双向协作桥：共享信箱、任务、共同记录，并支持互相唤醒。",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
